{
  "name": "codeceptjs-puppeteer",
  "version": "1.0.0",
  "private": true,
  "description": "CodeceptJS + Puppeteer automation framework for Guidewire PolicyCenter (Personal Auto)",
  "type": "module",
  "scripts": {
    "test": "node scripts/run.js",
    "test:headed": "node scripts/run.js --headed",
    "test:smoke": "node scripts/run.js --tags @smoke",
    "test:regression": "node scripts/run.js --tags @regression",
    "test:uat1": "node scripts/run.js --env uat1",
    "test:uat2": "node scripts/run.js --env uat2",
    "test:firefox": "node scripts/run.js --browser firefox",
    "test:parallel": "node scripts/run.js --workers 3",
    "test:unit": "node --test unit/*.test.js",
    "test:build": "codeceptjs dry-run && node --test unit/*.test.js",
    "install:firefox": "puppeteer browsers install firefox",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "def": "codeceptjs def"
  },
  "devDependencies": {
    "@codeceptjs/helper": "^2.0.4",
    "@eslint/js": "^9.39.5",
    "codeceptjs": "^4.1.0",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "puppeteer": "^25.9.0"
  }
}
