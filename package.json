{
  "name": "codeceptjs-puppeteer",
  "version": "1.0.0",
  "private": true,
  "description": "CodeceptJS + Puppeteer automation framework for Guidewire PolicyCenter (Personal Auto)",
  "type": "module",
  "scripts": {
    "test": "codeceptjs run --steps",
    "test:smoke": "codeceptjs run --steps --grep \"@smoke\"",
    "test:regression": "codeceptjs run --steps --grep \"@regression\"",
    "test:headed": "cross-env HEADLESS=false codeceptjs run --steps",
    "test:uat1": "cross-env ENV=uat1 codeceptjs run --steps",
    "test:uat2": "cross-env ENV=uat2 codeceptjs run --steps",
    "test:firefox": "cross-env BROWSER=firefox codeceptjs run --steps",
    "test:parallel": "codeceptjs run-workers 3",
    "install:firefox": "puppeteer browsers install firefox",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "def": "codeceptjs def"
  },
  "devDependencies": {
    "@codeceptjs/helper": "^2.0.4",
    "@eslint/js": "^9.39.5",
    "codeceptjs": "^4.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "puppeteer": "^25.9.0"
  }
}
